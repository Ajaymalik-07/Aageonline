# ==============================================================================
# AageOnline — Local Development Environment Variables Template
# Milestone 0.20.6: Local Development → Production Deployment Architecture
# Copy this file to `.env.local` or `.env` for local workstation execution.
# ==============================================================================

# --- Application Runtime & Environment ---
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# --- Local Ingress & Port ---
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Local PostgreSQL Database (Optional - in-memory fallback available for tests) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aageonline_dev?sslmode=disable
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=5

# --- Cryptographic Security Keys (Local Dev Safe Mock Values) ---
AUTH_SECRET=local_development_auth_secret_0123456789abcdef0123456789abcdef
RATE_LIMIT_SALT=local_dev_rate_limit_salt_0123456789abcdef

# --- PayU India Sandbox Payment Gateway (Test Sandbox Keys) ---
PAYU_ENV=test
PAYU_MERCHANT_KEY=gtKFFx
PAYU_MERCHANT_SALT=eCwWELxi

# --- Local Email & Notification Behavior ---
NOTIFICATION_EMAIL_ENABLED=false
EMAIL_SAFETY_SINK_ENABLED=true
