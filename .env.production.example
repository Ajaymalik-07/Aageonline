# ==============================================================================
# AageOnline — Production Environment Variables Template
# Milestone 0.20.6: Local Development → Production Deployment Architecture
# Copy this file to `.env.production` on the production server and populate credentials.
# NEVER COMMIT `.env.production` OR ACTUAL SECRETS TO VERSION CONTROL!
# ==============================================================================

# --- Application Runtime & Environment ---
NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_TELEMETRY_DISABLED=1

# --- Domain & Ingress Routing ---
SITE_ADDRESS=aageonline.com
ACME_EMAIL=admin@aageonline.com
NEXT_PUBLIC_APP_URL=https://aageonline.com

# --- PostgreSQL Database (Provider-Neutral Dual Options) ---
# Option A: Same-Host Containerized PostgreSQL (docker compose --profile local-db up -d)
# POSTGRES_DB=aageonline
# POSTGRES_USER=aageonline
# POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE
# DATABASE_URL=postgresql://aageonline:GENERATE_STRONG_RANDOM_PASSWORD_HERE@db:5432/aageonline
# DATABASE_SSL=false
#
# Option B: External Managed PostgreSQL 16+ (SSL/TLS Enforced)
# Examples: DigitalOcean Managed DB, AWS RDS/Lightsail, Supabase, Neon, GCP Cloud SQL.
#
# CRITICAL: Direct Session Connection & Advisory Lock Safeguards:
# Background worker and database migrator rely on session-level PostgreSQL advisory locks:
# - Migration lock: pg_try_advisory_lock(829104812)
# - Worker single-instance lock: pg_try_advisory_lock(94827104)
# DATABASE_URL MUST point to the direct session connection port (typically 5432 or 25060).
# DO NOT connect through transaction-mode connection poolers (e.g. port 6543 / PgBouncer transaction mode),
# as transaction pooling switches sessions between queries and silently breaks session advisory locks.
DATABASE_URL=postgresql://production_user:SECURE_PRODUCTION_PASSWORD@managed-db.example.com:5432/aageonline_production?sslmode=require

# TLS Certificate Verification:
# sslmode=require encrypts in transit but does NOT verify the server certificate without CA checks.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true enforces strict CA certificate chain verification.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Aggregate Database Connection Budget:
# - Web service: 10 connections (DATABASE_MAX_CONNECTIONS=10)
# - API service: 10 connections (DATABASE_MAX_CONNECTIONS=10)
# - Worker service: 5 connections
# - Migrator service: 1 connection (runs one-off before web/api rollout)
# Total aggregate connection footprint: 25 connections max.
# Ensure your managed PostgreSQL database pool permits at least 25 concurrent connections.
DATABASE_MAX_CONNECTIONS=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# --- Cryptographic Security Keys ---
# Generate using: openssl rand -hex 32 (Must be at least 32 characters, 64-char hex recommended)
# Deployment scripts will strictly reject missing keys or placeholder values (e.g. REPLACE_WITH_*).
AUTH_SECRET=REPLACE_WITH_64_CHAR_HEX_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_RANDOM_SECRET
RATE_LIMIT_SALT=REPLACE_WITH_64_CHAR_HEX_RANDOM_SECRET
ADMIN_TOKEN=REPLACE_WITH_64_CHAR_HEX_RANDOM_SECRET

# --- Reverse Proxy Network Configuration ---
# Trusted IP / CIDR ranges for the reverse proxy (Docker bridge network or private VPS ranges)
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# --- PayU India Payment Gateway (Production Mode) ---
# PAYU_ENV must be explicitly set to 'test' or 'production'.
# In production, set PAYU_ENV=production and use genuine merchant portal keys.
# Non-production (staging/test) environments MUST NOT use PAYU_ENV=production.
# NEVER commit or expose PAYU_MERCHANT_SALT.
PAYU_ENV=production
PAYU_MERCHANT_KEY=REPLACE_WITH_PRODUCTION_PAYU_KEY
PAYU_MERCHANT_SALT=REPLACE_WITH_PRODUCTION_PAYU_SALT

# --- Production Transactional Email Service ---
# Set to 'true' once email provider credentials (SMTP, Resend, or SendGrid) are verified.
NOTIFICATION_EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=notifications@aageonline.com
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASS

# Mandatory Non-Production Safety Invariant (Local Testing & Preflight):
# When APP_ENV != 'production', outbound emails are NEVER sent to real customer mailboxes.
# If NOTIFICATION_EMAIL_ENABLED=true in non-production, EMAIL_SAFETY_SINK_ENABLED MUST be set to true.
# Outbound emails will be intercepted into local log sinks unless addressed to SAFE_TEST_EMAIL_RECIPIENT.
EMAIL_SAFETY_SINK_ENABLED=false
SAFE_TEST_EMAIL_RECIPIENT=ops@aageonline.com
