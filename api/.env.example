# AageOnline — API Service Configuration
PORT=4000
NODE_ENV=development

# Allowed CORS Origins (Comma-separated for Website and Admin clients)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://aageonline.com,https://www.aageonline.com,https://admin.aageonline.com

# PostgreSQL Database Connection
DATABASE_URL=postgresql://aage_app:dev_secret_local@127.0.0.1:5432/aageonline_dev
PGSSLMODE=disable

# Authentication Secrets
JWT_SECRET=dev-insecure-local-jwt-secret-do-not-use-in-production
ADMIN_TOKEN=dev-admin-secret-token

# Payment Gateway Configuration
PAYMENT_PROVIDER_MODE=mock
PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret

