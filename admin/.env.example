# AageOnline — Admin Service Configuration
PORT=3001
NODE_ENV=development

# Administrative Security Secrets
ADMIN_TOKEN=your-admin-token-here-min-32-chars
SESSION_SECRET=your-session-secret-salt-min-32-chars

# Authoritative Backend API URL (Port 4000 locally, http://api:4000 in Docker, api.aageonline.com in production)
INTERNAL_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public Website URL (Port 3000 locally, aageonline.com in production)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Admin Portal Host
NEXT_PUBLIC_ADMIN_HOST=admin.aageonline.com
